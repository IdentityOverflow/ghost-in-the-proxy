# ghost-in-the-proxy — default configuration (committed).
# Priority: shell environment > .env (your local overrides/secrets, gitignored) > this file.
# With these defaults:   uvicorn server.main:app --port 8000
# then point any OpenAI-compatible client at http://localhost:8000/v1

# ── Backend: LM Studio on this machine ──────────────────────────────────────
DEFAULT_PROVIDER=lmstudio
# No /v1 here — the provider appends it.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234
# Reasoning models think on every API call unless the SERVER-side model config
# (LM Studio has separate chat-UI and server settings) or this says otherwise.
LMSTUDIO_EXTRA_BODY={"reasoning_effort":"none"}
# Local models are slow; never retry a client-facing call by default.
PROVIDER_RETRIES=0

# ── The mind ────────────────────────────────────────────────────────────────
MIND_ENABLED=1
# The context length the model is LOADED with in LM Studio (8k is the design floor).
MIND_WINDOW=8192
# open = a mind error falls back to plain passthrough; strict = fail loudly (evals).
MIND_FAIL_MODE=open
MIND_DB_DIR=var/minds

# Raw-memory backend: embedding (semantic recall + auto-cue) needs an embeddings
# model loaded in LM Studio; set to "lexical" if you have none.
MIND_MEM_BACKEND=embedding
MIND_EMBED_BASE_URL=http://127.0.0.1:1234/v1
MIND_EMBED_MODEL=text-embedding-bge-m3

# Steward/consolidation model. Empty = the conversation model. LM Studio serves
# one request at a time, so a background fold can queue ahead of your next
# message; a second, smaller model here (or a remote one via MODEL_MAP) avoids it.
MIND_EXTRACTION_MODEL=
# How long a request waits for an in-flight background fold before going ahead.
MIND_MAINTENANCE_WAIT_S=60

# Telemetry (JSONL per request/fold). Empty = off.
MIND_METRICS_PATH=

# ── Other providers (set keys in .env, not here) ───────────────────────────
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# OPENROUTER_API_KEY=            # → .env
# OPENROUTER_EXTRA_BODY={"reasoning":{"enabled":false}}
# MODEL_MAP={"wren-remote":"openrouter:google/gemma-4-26b-a4b-it"}
